pragma solidity 0.8.28;

// DEPRECATED: This script uses the old UniversalEscrowAdapter architecture
// TODO: Update to use new UniversalAdapterEscrow architecture

import "forge-std/Script.sol";
import "../src/VaultV2.sol";
// import "../src/adapters/UniversalEscrowAdapter.sol";  // DEPRECATED
// import "../src/adapters/StrategyEscrow.sol";  // DEPRECATED
import "../src/valuers/UniversalValuerOffchain.sol";
import {IERC20} from "../src/interfaces/IERC20.sol";
// import {IStrategyEscrow} from "../src/adapters/interfaces/IStrategyEscrow.sol";  // DEPRECATED

contract PTKHYPELoopEndToEnd is Script {
    // HyperEVM mainnet addresses
    address constant KHYPE = 0xfD739d4e423301CE9385c1fb8850539D657C296D;
    address constant WHYPE = 0x0000000000000000000000000000000000000001; // Wrapped HYPE

    // Pendle Protocol addresses
    address constant PENDLE_ROUTER = 0x888888888889758F76e7103c6CbF23ABbF58F946;
    address constant PT_KHYPE = 0x311dB0FDe558689550c68355783c95eFDfe25329; // PT-kHYPE-26DEC2024
    address constant SY_KHYPE = 0x8867d2b7aDb8609c51810237EcC9A25A2F601B97; // SY-kHYPE
    address constant YT_KHYPE = 0xf909EAfC8BFA27CADC44e5d3aDBc088CeA4C3623; // YT-kHYPE-26DEC2024
    address constant KHYPE_POOL = 0x06a2D0E7e2A99A59cF96ae84F3dBFf5A0ee22f5e; // kHYPE/PT-kHYPE AMM
    address constant PENDLE_ORACLE = 0x9a9Fa8338dd5E5B2188006f1Cd2Ef26d921650C2; // Pendle PT Oracle

    // Felix Protocol integration (hypothetical addresses)
    address constant FELIX_YIELD_OPTIMIZER = 0x5555555555555555555555555555555555555555;
    address constant FELIX_RISK_MANAGER = 0x6666666666666666666666666666666666666666;

    // Strategy configuration
    bytes32 constant PT_KHYPE_LOOP_ID = keccak256("pt-khype-loop");
    bytes32 constant FELIX_OPTIMIZER_ID = keccak256("felix-yield-optimizer");
    uint256 constant DEPOSIT_AMOUNT = 0.001 ether;
    uint256 constant ALLOCATION_AMOUNT = 0.001 ether;

    // Deployed contracts
    VaultV2 public vault;
    StrategyEscrow public escrow;
    UniversalEscrowAdapter public adapter;
    UniversalValuerOffchain public valuer;

    // Test accounts
    address public deployer;
    uint256 public signerKey = 0xabc123; // Example signer key for offchain valuation
    address public signer;

    function run() public {
        uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
        deployer = vm.addr(deployerPrivateKey);
        signer = vm.addr(signerKey);

        console.log("\n=================================================");
        console.log("    PT-kHYPE LOOP STRATEGY END-TO-END TEST    ");
        console.log("         Pendle & Felix Integration           ");
        console.log("=================================================");
        console.log("\nDeployer:", deployer);
        console.log("Network: HyperEVM (Chain ID 999)");

        vm.startBroadcast(deployerPrivateKey);

        // Phase 1: Deploy Core Infrastructure
        deployCore();

        // Phase 2: Setup Strategy Escrow
        setupStrategyEscrow();

        // Phase 3: Configure Vault
        configureVault();

        // Phase 4: Configure Pendle Integration
        configurePendleIntegration();

        // Phase 5: Configure Felix Integration
        configureFelixIntegration();

        // Phase 6: Deposit and Allocate
        depositAndAllocate();

        // Phase 7: Demonstrate Strategy Capabilities
        demonstrateStrategy();

        vm.stopBroadcast();

        // Final Summary
        printSummary();
    }

    function deployCore() internal {
        console.log("\n=================================================");
        console.log("PHASE 1: DEPLOYING CORE INFRASTRUCTURE");
        console.log("===============================================");

        // Deploy Vault
        console.log("\n1. Deploying VaultV2...");
        vault = new VaultV2(deployer, KHYPE);
        console.log("   [OK] Vault deployed at:", address(vault));

        // Set curator (owner is deployer, so we can set curator)
        vault.setCurator(deployer);
        console.log("   [OK] Curator set to deployer");

        // Deploy Offchain Valuer
        console.log("\n2. Deploying UniversalValuerOffchain...");
        valuer = new UniversalValuerOffchain(deployer, KHYPE);
        console.log("   [OK] Valuer deployed at:", address(valuer));

        // Configure valuer with signer (using timelock system)
        valuer.initiateSignerChange(signer, true, 1);
        console.log("   [OK] Initiated signer addition:", signer);
        console.log("   Note: Signer change requires 24h timelock in production");

        // Deploy StrategyEscrow (without adapter - new pattern)
        console.log("\n3. Deploying StrategyEscrow...");
        escrow = new StrategyEscrow(address(0), deployer); // First param ignored, will use setAdapter()
        console.log("   [OK] Escrow deployed at:", address(escrow));

        // Deploy UniversalEscrowAdapter
        console.log("\n4. Deploying UniversalEscrowAdapter...");
        adapter = new UniversalEscrowAdapter(
            address(vault),
            address(escrow),
            address(valuer),
            true // using offchain valuer
        );
        console.log("   [OK] Adapter deployed at:", address(adapter));
    }

    function setupStrategyEscrow() internal {
        console.log("\n=================================================");
        console.log("PHASE 2: SETTING UP STRATEGY ESCROW");
        console.log("===============================================");

        // CRITICAL: Set adapter in escrow (solving circular dependency)
        console.log("\n1. Linking Adapter to Escrow...");
        escrow.setAdapter(address(adapter));
        console.log("   [OK] Adapter set in escrow");

        // Verify linkage
        require(escrow.adapter() == address(adapter), "Adapter not set correctly");
        require(escrow.adapterLocked(), "Adapter not locked");
        console.log("   [OK] Circular dependency SOLVED!");
        console.log("   [OK] Adapter locked permanently");

        // Set strategy agents
        console.log("\n2. Setting Strategy Agents...");
        escrow.setStrategyAgent(PT_KHYPE_LOOP_ID, deployer);
        escrow.setStrategyAgent(FELIX_OPTIMIZER_ID, deployer);
        console.log("   [OK] PT-kHYPE Loop agent set");
        console.log("   [OK] Felix Optimizer agent set");

        // Configure whitelist for kHYPE operations
        console.log("\n3. Configuring Whitelist...");
        bytes4 approveSelector = bytes4(keccak256("approve(address,uint256)"));
        bytes4 transferSelector = bytes4(keccak256("transfer(address,uint256)"));

        escrow.updateWhitelist(KHYPE, approveSelector, true, 100 ether);
        escrow.updateWhitelist(KHYPE, transferSelector, true, 100 ether);
        console.log("   [OK] kHYPE approve/transfer whitelisted");
    }

    function configureVault() internal {
        console.log("\n=================================================");
        console.log("PHASE 3: CONFIGURING VAULT");
        console.log("===============================================");

        // Set allocator role
        console.log("\n1. Setting Allocator Role...");
        bytes memory allocatorData = abi.encodeWithSignature(
            "setIsAllocator(address,bool)",
            deployer,
            true
        );
        vault.submit(allocatorData);
        vault.setIsAllocator(deployer, true);
        console.log("   [OK] Allocator role granted");

        // Register adapter
        console.log("\n2. Registering Adapter...");
        bytes memory adapterData = abi.encodeWithSignature(
            "addAdapter(address)",
            address(adapter)
        );
        vault.submit(adapterData);
        vault.addAdapter(address(adapter));
        console.log("   [OK] Adapter registered in vault");

        // Set allocation caps
        console.log("\n3. Setting Allocation Caps...");

        // PT-kHYPE Loop cap
        bytes memory ptCapIdData = bytes("pt-khype-loop");
        bytes memory ptCapData = abi.encodeWithSignature(
            "increaseAbsoluteCap(bytes,uint256)",
            ptCapIdData,
            10 ether
        );
        vault.submit(ptCapData);
        vault.increaseAbsoluteCap(ptCapIdData, 10 ether);
        console.log("   [OK] PT-kHYPE Loop cap: 10 kHYPE");

        // Relative cap
        bytes memory relCapData = abi.encodeWithSignature(
            "increaseRelativeCap(bytes,uint256)",
            ptCapIdData,
            1e18 // 100%
        );
        vault.submit(relCapData);
        vault.increaseRelativeCap(ptCapIdData, 1e18);
        console.log("   [OK] Relative cap: 100%");
    }

    function configurePendleIntegration() internal {
        console.log("\n=================================================");
        console.log("PHASE 4: CONFIGURING PENDLE INTEGRATION");
        console.log("===============================================");

        console.log("\n1. Whitelisting Pendle Contracts...");

        // Whitelist Pendle Router
        escrow.updateWhitelist(PENDLE_ROUTER, bytes4(0), true, 100 ether);
        console.log("   [OK] Pendle Router whitelisted");

        // Whitelist PT-kHYPE token
        escrow.updateWhitelist(PT_KHYPE, bytes4(0), true, 100 ether);
        console.log("   [OK] PT-kHYPE token whitelisted");

        // Whitelist SY-kHYPE (Standardized Yield Token)
        escrow.updateWhitelist(SY_KHYPE, bytes4(0), true, 100 ether);
        console.log("   [OK] SY-kHYPE token whitelisted");

        // Whitelist YT-kHYPE (Yield Token)
        escrow.updateWhitelist(YT_KHYPE, bytes4(0), true, 100 ether);
        console.log("   [OK] YT-kHYPE token whitelisted");

        // Whitelist kHYPE/PT-kHYPE AMM pool
        escrow.updateWhitelist(KHYPE_POOL, bytes4(0), true, 100 ether);
        console.log("   [OK] kHYPE/PT-kHYPE pool whitelisted");

        console.log("\n2. Pendle Strategy Configuration:");
        console.log("   * Maturity: December 26, 2024");
        console.log("   * Fixed APY: Locked at swap time");
        console.log("   * YT Trading: Available for yield speculation");
        console.log("   * AMM Pool: Provides liquidity and price discovery");
    }

    function configureFelixIntegration() internal {
        console.log("\n=================================================");
        console.log("PHASE 5: CONFIGURING FELIX INTEGRATION");
        console.log("===============================================");

        console.log("\n1. Felix Protocol Integration Points:");
        console.log("   * Yield Optimizer: Automatically rebalances PT/YT");
        console.log("   * Risk Manager: Monitors position health");
        console.log("   * Auto-Compounder: Reinvests yields");
        console.log("   * Liquidation Protection: Prevents underwater positions");

        // Whitelist Felix contracts (if deployed)
        if (FELIX_YIELD_OPTIMIZER != address(0x5555555555555555555555555555555555555555)) {
            escrow.updateWhitelist(FELIX_YIELD_OPTIMIZER, bytes4(0), true, 100 ether);
            console.log("   [OK] Felix Yield Optimizer whitelisted");
        }

        if (FELIX_RISK_MANAGER != address(0x6666666666666666666666666666666666666666)) {
            escrow.updateWhitelist(FELIX_RISK_MANAGER, bytes4(0), true, 100 ether);
            console.log("   [OK] Felix Risk Manager whitelisted");
        }
    }

    function depositAndAllocate() internal {
        console.log("\n=================================================");
        console.log("PHASE 6: DEPOSIT AND ALLOCATE");
        console.log("===============================================");

        IERC20 khype = IERC20(KHYPE);

        // Check balances
        console.log("\n1. Initial Balances:");
        uint256 userBalance = khype.balanceOf(deployer);
        console.log("   User kHYPE:", userBalance);
        console.log("   Vault kHYPE:", khype.balanceOf(address(vault)));

        // Deposit to vault
        if (userBalance >= DEPOSIT_AMOUNT) {
            console.log("\n2. Depositing to Vault...");
            khype.approve(address(vault), DEPOSIT_AMOUNT);
            uint256 shares = vault.deposit(DEPOSIT_AMOUNT, deployer);
            console.log("   [OK] Deposited:", DEPOSIT_AMOUNT);
            console.log("   [OK] Shares received:", shares);

            // Allocate to PT-kHYPE Loop strategy
            console.log("\n3. Allocating to PT-kHYPE Loop Strategy...");

            // Prepare allocation data
            IStrategyEscrow.Call[] memory calls = new IStrategyEscrow.Call[](0);
            bytes memory escrowCallData = abi.encode(calls);
            bytes memory allocationData = abi.encode(
                PT_KHYPE_LOOP_ID,
                ALLOCATION_AMOUNT,
                escrowCallData
            );

            // Generate signature for offchain valuation (simplified for demo)
            bytes memory signature = generateValuationSignature();

            // Execute allocation
            try vault.allocate(address(adapter), allocationData, ALLOCATION_AMOUNT) {
                uint256 escrowBalance = khype.balanceOf(address(escrow));
                console.log("   [OK] ALLOCATION SUCCESSFUL!");
                console.log("   [OK] Escrow received:", escrowBalance);

                // Approve Pendle Router
                if (escrowBalance > 0) {
                    console.log("\n4. Enabling Pendle Trading...");
                    IStrategyEscrow.Call[] memory pendleCalls = new IStrategyEscrow.Call[](1);
                    pendleCalls[0] = IStrategyEscrow.Call({
                        target: KHYPE,
                        value: 0,
                        data: abi.encodeWithSignature(
                            "approve(address,uint256)",
                            PENDLE_ROUTER,
                            escrowBalance
                        )
                    });

                    escrow.executeMulticall(PT_KHYPE_LOOP_ID, pendleCalls);

                    uint256 allowance = khype.allowance(address(escrow), PENDLE_ROUTER);
                    console.log("   [OK] Pendle Router approved:", allowance);
                }
            } catch Error(string memory reason) {
                console.log("   [ERROR] Allocation failed:", reason);
            } catch {
                console.log("   [ERROR] Allocation failed");
            }
        } else {
            console.log("   [ERROR] Insufficient kHYPE balance");
        }
    }

    function demonstrateStrategy() internal {
        console.log("\n=================================================");
        console.log("PHASE 7: PT-kHYPE LOOP STRATEGY DEMONSTRATION");
        console.log("===============================================");

        console.log("\nSTRATEGY WORKFLOW:");
        console.log("\n1. Initial Position:");
        console.log("   kHYPE -> Pendle Router -> PT-kHYPE + YT-kHYPE");
        console.log("   * PT-kHYPE: Fixed yield until maturity");
        console.log("   * YT-kHYPE: Variable yield token");

        console.log("\n2. Loop Mechanism:");
        console.log("   * At maturity: PT-kHYPE -> kHYPE");
        console.log("   * Re-deposit: kHYPE -> New PT-kHYPE");
        console.log("   * Compound: Yields reinvested");

        console.log("\n3. Felix Optimization:");
        console.log("   * Dynamic Rebalancing: PT/YT ratio optimization");
        console.log("   * Yield Farming: YT liquidity provision");
        console.log("   * Risk Management: Position monitoring");

        console.log("\n4. Example Transaction Flow:");
        console.log("   Step 1: Swap 1000 kHYPE for ~1050 PT-kHYPE");
        console.log("   Step 2: Hold until maturity (5% fixed APY)");
        console.log("   Step 3: Redeem 1050 PT-kHYPE for 1050 kHYPE");
        console.log("   Step 4: Re-enter with 1050 kHYPE (compound)");

        console.log("\nSTRATEGY METRICS:");
        console.log("   * Target APY: 15-25% (market dependent)");
        console.log("   * Risk Level: Low (principal protected)");
        console.log("   * Lock Period: Until PT maturity");
        console.log("   * Auto-Compound: Yes (via Felix)");
    }

    function generateValuationSignature() internal view returns (bytes memory) {
        // Simplified signature generation for demo
        // In production, this would be done off-chain
        bytes32 messageHash = keccak256(abi.encodePacked(
            address(escrow),
            block.timestamp,
            uint256(0) // valuation
        ));

        (uint8 v, bytes32 r, bytes32 s) = vm.sign(signerKey, messageHash);
        return abi.encodePacked(r, s, v);
    }

    function printSummary() internal view {
        console.log("\n=================================================");
        console.log("            DEPLOYMENT SUMMARY                ");
        console.log("=================================================");

        console.log("\nDEPLOYED CONTRACTS:");
        console.log("  - Vault:", address(vault));
        console.log("  - Escrow:", address(escrow));
        console.log("  - Adapter:", address(adapter));
        console.log("  - Valuer:", address(valuer));

        console.log("\nINTEGRATIONS:");
        console.log("  - Pendle Router:", PENDLE_ROUTER);
        console.log("  - PT-kHYPE:", PT_KHYPE);
        console.log("  - SY-kHYPE:", SY_KHYPE);
        console.log("  - YT-kHYPE:", YT_KHYPE);
        console.log("  - AMM Pool:", KHYPE_POOL);

        IERC20 khype = IERC20(KHYPE);
        console.log("\nFINAL BALANCES:");
        console.log("  - Vault kHYPE:", khype.balanceOf(address(vault)));
        console.log("  - Escrow kHYPE:", khype.balanceOf(address(escrow)));
        console.log("  - User Shares:", vault.balanceOf(deployer));
        console.log("  - Pendle Allowance:", khype.allowance(address(escrow), PENDLE_ROUTER));

        console.log("\nSTATUS:");
        console.log("  - Circular Dependency: SOLVED");
        console.log("  - Adapter Locked: ", escrow.adapterLocked() ? "YES" : "NO");
        console.log("  - Allocator Set: ", vault.isAllocator(deployer) ? "YES" : "NO");
        console.log("  - Adapter Registered: ", vault.isAdapter(address(adapter)) ? "YES" : "NO");
        console.log("  - Strategy Ready: ", khype.balanceOf(address(escrow)) > 0 ? "YES" : "NO");

        console.log("\nNEXT STEPS:");
        console.log("1. Execute PT-kHYPE swap via Pendle Router");
        console.log("2. Monitor position via Felix Dashboard");
        console.log("3. Claim yields at maturity");
        console.log("4. Re-loop for compounding");

        console.log("\n=================================================");
        console.log("   PT-kHYPE LOOP STRATEGY READY FOR PRODUCTION!");
        console.log("=================================================");
    }
}