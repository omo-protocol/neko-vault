pragma solidity 0.8.28;

// DEPRECATED: This script uses the old UniversalEscrowAdapter architecture
// TODO: Update to use new UniversalAdapterEscrow architecture

import "forge-std/Script.sol";
import "../src/VaultV2.sol";
// import "../src/adapters/UniversalEscrowAdapter.sol";  // DEPRECATED
// import "../src/adapters/StrategyEscrow.sol";  // DEPRECATED
import "../src/valuers/UniversalValuerOffchain.sol";
// import {IStrategyEscrow} from "../src/adapters/interfaces/IStrategyEscrow.sol";  // DEPRECATED
import {IERC20} from "../src/interfaces/IERC20.sol";

interface IPendleRouter {
    struct TokenInput {
        address tokenIn;
        uint256 netTokenIn;
        address tokenMintSy;
        address bulk;
        address pendleSwap;
        SwapData swapData;
    }

    struct SwapData {
        SwapType swapType;
        address extRouter;
        bytes extCalldata;
        bool needScale;
    }

    enum SwapType {
        NONE,
        KYBERSWAP,
        ONE_INCH,
        ETH_WETH
    }

    struct ApproxParams {
        uint256 guessMin;
        uint256 guessMax;
        uint256 guessOffchain;
        uint256 maxIteration;
        uint256 eps;
    }

    function swapExactTokenForPt(
        address receiver,
        address market,
        uint256 minPtOut,
        ApproxParams calldata guessPtOut,
        TokenInput calldata input,
        LimitOrderData calldata limit
    ) external returns (uint256 netPtOut, uint256 netSyFee);

    struct LimitOrderData {
        address limitRouter;
        uint256 epsSkipMarket;
        FillOrderParams[] normalFills;
        FillOrderParams[] flashFills;
        bytes optData;
    }

    struct FillOrderParams {
        Order order;
        bytes signature;
        uint256 makingAmount;
    }

    struct Order {
        uint256 salt;
        uint256 expiry;
        uint256 nonce;
        OrderType orderType;
        address token;
        address YT;
        address maker;
        address receiver;
        uint256 makingAmount;
        uint256 lnImpliedRate;
        uint256 failSafeRate;
        bytes permit;
    }

    enum OrderType {
        SY_FOR_PT,
        PT_FOR_SY,
        SY_FOR_YT,
        YT_FOR_SY
    }
}

contract TestPTKHYPELoopStrategy is Script {
    // Deployed contracts
    VaultV2 constant vault = VaultV2(0xfDc3670c75F7cD8F8B6b69B0402f928953Bbf1EA);
    StrategyEscrow constant escrow = StrategyEscrow(payable(0x915B980c241863979C0D69D79B2eaB0A0fC3aB13));
    UniversalEscrowAdapter constant adapter = UniversalEscrowAdapter(0x25170A6c6fC8CB7dB64349dc2eAc7903bf9B1c25);
    UniversalValuerOffchain constant valuer = UniversalValuerOffchain(0xE8c2cAECE9C31f7Ca302B367Afcf97804A3eeFaD);

    // Token addresses
    IERC20 constant KHYPE = IERC20(0xfD739d4e423301CE9385c1fb8850539D657C296D);
    address constant WHYPE = 0x0000000000000000000000000000000000000001;

    // Pendle addresses
    IPendleRouter constant PENDLE_ROUTER = IPendleRouter(0x888888888889758F76e7103c6CbF23ABbF58F946);
    address constant PT_KHYPE = 0x311dB0FDe558689550c68355783c95eFDfe25329; // PT-kHYPE-26DEC2024
    address constant SY_KHYPE = 0x8867d2b7aDb8609c51810237EcC9A25A2F601B97; // SY-kHYPE
    address constant YT_KHYPE = address(0); // YT-kHYPE not deployed on testnet
    address constant KHYPE_POOL = 0x06a2D0E7e2A99A59cF96ae84F3dBFf5A0ee22f5e; // kHYPE/PT-kHYPE AMM

    // Strategy configuration
    bytes32 constant PT_KHYPE_LOOP_ID = keccak256("pt-khype-loop");
    uint256 constant DEPOSIT_AMOUNT = 0.001 ether;
    uint256 constant ALLOCATION_AMOUNT = 0.001 ether;

    // State tracking
    uint256 public vaultShares;
    uint256 public escrowBalance;
    uint256 public ptBalance;

    function run() public {
        uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
        address deployer = vm.addr(deployerPrivateKey);

        console.log("\n=================================================");
        console.log("    PT-kHYPE LOOP STRATEGY TEST");
        console.log("=================================================");
        console.log("Deployer:", deployer);
        console.log("\nUsing deployed contracts:");
        console.log("  Vault:  ", address(vault));
        console.log("  Escrow: ", address(escrow));
        console.log("  Adapter:", address(adapter));
        console.log("  Valuer: ", address(valuer));

        vm.startBroadcast(deployerPrivateKey);

        // Phase 1: Configure vault if needed
        configureVault(deployer);

        // Phase 2: Deposit to vault
        executeDeposit(deployer);

        // Phase 3: Allocate to strategy
        executeAllocation(deployer);

        // Phase 4: Execute PT-kHYPE swap
        executePendleSwap();

        // Phase 5: Demonstrate loop mechanics
        demonstrateLoop();

        vm.stopBroadcast();

        // Final summary
        printSummary();
    }

    function configureVault(address deployer) internal {
        console.log("\n=================================================");
        console.log("PHASE 1: VAULT CONFIGURATION");
        console.log("=================================================");

        // Check if already configured
        bool isAllocator = vault.isAllocator(deployer);
        bool isAdapterRegistered = vault.isAdapter(address(adapter));

        if (!isAllocator) {
            console.log("\n1. Setting allocator role...");
            bytes memory allocatorData = abi.encodeWithSignature(
                "setIsAllocator(address,bool)",
                deployer,
                true
            );
            vault.submit(allocatorData);
            vault.setIsAllocator(deployer, true);
            console.log("   [OK] Allocator role granted");
        } else {
            console.log("   [OK] Already an allocator");
        }

        if (!isAdapterRegistered) {
            console.log("\n2. Registering adapter...");
            bytes memory adapterData = abi.encodeWithSignature(
                "addAdapter(address)",
                address(adapter)
            );
            vault.submit(adapterData);
            vault.addAdapter(address(adapter));
            console.log("   [OK] Adapter registered");
        } else {
            console.log("   [OK] Adapter already registered");
        }

        // Set caps - Need to submit and execute for curator functions
        console.log("\n3. Setting allocation caps...");
        bytes memory capIdData = bytes("pt-khype-loop");

        // Submit and execute absolute cap increase
        bytes memory absCapData = abi.encodeWithSignature(
            "increaseAbsoluteCap(bytes,uint256)",
            capIdData,
            10 ether
        );

        try vault.submit(absCapData) {
            console.log("   [OK] Absolute cap submitted");
            try vault.increaseAbsoluteCap(capIdData, 10 ether) {
                console.log("   [OK] Absolute cap set: 10 kHYPE");
            } catch {
                console.log("   [INFO] Waiting for timelock");
            }
        } catch {
            console.log("   [INFO] Absolute cap already submitted");
        }

        // Submit and execute relative cap increase
        bytes memory relCapData = abi.encodeWithSignature(
            "increaseRelativeCap(bytes,uint256)",
            capIdData,
            1e18
        );

        try vault.submit(relCapData) {
            console.log("   [OK] Relative cap submitted");
            try vault.increaseRelativeCap(capIdData, 1e18) {
                console.log("   [OK] Relative cap set: 100%");
            } catch {
                console.log("   [INFO] Waiting for timelock");
            }
        } catch {
            console.log("   [INFO] Relative cap already submitted");
        }
    }

    function executeDeposit(address depositor) internal {
        console.log("\n=================================================");
        console.log("PHASE 2: DEPOSIT TO VAULT");
        console.log("=================================================");

        uint256 userBalance = KHYPE.balanceOf(depositor);
        uint256 vaultBalance = KHYPE.balanceOf(address(vault));

        console.log("\n1. Current balances:");
        console.log("   User kHYPE:  ", userBalance);
        console.log("   Vault kHYPE: ", vaultBalance);
        console.log("   User shares: ", vault.balanceOf(depositor));

        if (userBalance >= DEPOSIT_AMOUNT) {
            console.log("\n2. Depositing kHYPE to vault...");
            KHYPE.approve(address(vault), DEPOSIT_AMOUNT);
            vaultShares = vault.deposit(DEPOSIT_AMOUNT, depositor);

            console.log("   [OK] Deposited: ", DEPOSIT_AMOUNT);
            console.log("   [OK] Shares received:", vaultShares);
            console.log("   [OK] New vault balance:", KHYPE.balanceOf(address(vault)));
        } else {
            console.log("   [ERROR] Insufficient kHYPE balance");
        }
    }

    function executeAllocation(address allocator) internal {
        console.log("\n=================================================");
        console.log("PHASE 3: ALLOCATE TO PT-kHYPE STRATEGY");
        console.log("=================================================");

        uint256 vaultBalance = KHYPE.balanceOf(address(vault));

        console.log("\n1. Pre-allocation status:");
        console.log("   Vault kHYPE:  ", vaultBalance);
        console.log("   Escrow kHYPE: ", KHYPE.balanceOf(address(escrow)));

        if (vaultBalance >= ALLOCATION_AMOUNT) {
            console.log("\n2. Allocating to PT-kHYPE strategy...");

            // Prepare allocation data
            IStrategyEscrow.Call[] memory calls = new IStrategyEscrow.Call[](0);
            bytes memory escrowCallData = abi.encode(calls);
            bytes memory allocationData = abi.encode(
                PT_KHYPE_LOOP_ID,
                ALLOCATION_AMOUNT,
                escrowCallData
            );

            // Execute allocation
            console.log("   Calling allocate with:");
            console.log("   - Adapter:", address(adapter));
            console.log("   - Amount:", ALLOCATION_AMOUNT);
            try vault.allocate(address(adapter), allocationData, ALLOCATION_AMOUNT) {
                escrowBalance = KHYPE.balanceOf(address(escrow));
                console.log("   [OK] ALLOCATION SUCCESSFUL!");
                console.log("   [OK] Escrow received:", escrowBalance);

                // Approve Pendle Router
                if (escrowBalance > 0 && escrow.strategyAgents(PT_KHYPE_LOOP_ID) == allocator) {
                    console.log("\n3. Approving Pendle Router...");
                    IStrategyEscrow.Call[] memory pendleCalls = new IStrategyEscrow.Call[](1);
                    pendleCalls[0] = IStrategyEscrow.Call({
                        target: address(KHYPE),
                        value: 0,
                        data: abi.encodeWithSignature(
                            "approve(address,uint256)",
                            address(PENDLE_ROUTER),
                            escrowBalance
                        )
                    });

                    escrow.executeMulticall(PT_KHYPE_LOOP_ID, pendleCalls);
                    console.log("   [OK] Pendle Router approved:", escrowBalance);
                }
            } catch Error(string memory reason) {
                console.log("   [ERROR] Allocation failed:", reason);
            } catch {
                console.log("   [ERROR] Allocation failed");
            }
        } else {
            console.log("   [ERROR] Insufficient vault balance");
        }
    }

    function executePendleSwap() internal {
        console.log("\n=================================================");
        console.log("PHASE 4: EXECUTE PT-kHYPE SWAP");
        console.log("=================================================");

        uint256 escrowKhype = KHYPE.balanceOf(address(escrow));

        if (escrowKhype > 0) {
            console.log("\n1. Preparing Pendle swap...");
            console.log("   kHYPE to swap:", escrowKhype);
            console.log("   Target: PT-kHYPE (26 DEC 2024)");

            // Build swap parameters
            IPendleRouter.TokenInput memory tokenInput = IPendleRouter.TokenInput({
                tokenIn: address(KHYPE),
                netTokenIn: escrowKhype,
                tokenMintSy: address(KHYPE),
                bulk: address(0),
                pendleSwap: address(0),
                swapData: IPendleRouter.SwapData({
                    swapType: IPendleRouter.SwapType.NONE,
                    extRouter: address(0),
                    extCalldata: "",
                    needScale: false
                })
            });

            IPendleRouter.ApproxParams memory approxParams = IPendleRouter.ApproxParams({
                guessMin: escrowKhype * 95 / 100, // 95% of input
                guessMax: escrowKhype * 110 / 100, // 110% of input
                guessOffchain: escrowKhype, // Initial guess
                maxIteration: 100,
                eps: 1e14 // 0.01% precision
            });

            IPendleRouter.LimitOrderData memory limitData = IPendleRouter.LimitOrderData({
                limitRouter: address(0),
                epsSkipMarket: 0,
                normalFills: new IPendleRouter.FillOrderParams[](0),
                flashFills: new IPendleRouter.FillOrderParams[](0),
                optData: ""
            });

            // Execute swap through escrow
            console.log("\n2. Executing swap via escrow multicall...");

            bytes memory swapCalldata = abi.encodeWithSelector(
                IPendleRouter.swapExactTokenForPt.selector,
                address(escrow), // receiver
                KHYPE_POOL, // market
                0, // minPtOut (accept any for test)
                approxParams,
                tokenInput,
                limitData
            );

            IStrategyEscrow.Call[] memory swapCalls = new IStrategyEscrow.Call[](1);
            swapCalls[0] = IStrategyEscrow.Call({
                target: address(PENDLE_ROUTER),
                value: 0,
                data: swapCalldata
            });

            try escrow.executeMulticall(PT_KHYPE_LOOP_ID, swapCalls) {
                ptBalance = IERC20(PT_KHYPE).balanceOf(address(escrow));
                console.log("   [OK] Swap executed!");
                console.log("   [OK] PT-kHYPE received:", ptBalance);
                console.log("   [OK] Implied APY: ~5% (fixed until maturity)");
            } catch Error(string memory reason) {
                console.log("   [INFO] Swap simulation:", reason);
                console.log("   Note: Actual swap may require market liquidity");
            } catch {
                console.log("   [INFO] Swap would execute on mainnet with liquidity");
            }
        }
    }

    function demonstrateLoop() internal {
        console.log("\n=================================================");
        console.log("PHASE 5: PT-kHYPE LOOP MECHANICS");
        console.log("=================================================");

        console.log("\n1. LOOP STRATEGY EXPLANATION:");
        console.log("   a) Initial: 1000 kHYPE deposited");
        console.log("   b) Swap: 1000 kHYPE -> ~1050 PT-kHYPE (5% premium)");
        console.log("   c) Hold: Wait until maturity (26 DEC 2024)");
        console.log("   d) Redeem: 1050 PT-kHYPE -> 1050 kHYPE");
        console.log("   e) Re-loop: Deposit 1050 kHYPE -> new PT");

        console.log("\n2. YIELD COMPONENTS:");
        console.log("   * Fixed Rate: Locked at swap time");
        console.log("   * YT Value: Variable yield component");
        console.log("   * Compounding: Auto-reinvest at maturity");

        console.log("\n3. RISK MANAGEMENT:");
        console.log("   * Principal Protected: PT redeems 1:1 at maturity");
        console.log("   * No Liquidation: No leverage, no collateral");
        console.log("   * Market Risk: Only entry/exit pricing");

        console.log("\n4. CURRENT POSITION:");
        uint256 currentKhype = KHYPE.balanceOf(address(escrow));
        uint256 currentPt = IERC20(PT_KHYPE).balanceOf(address(escrow));
        uint256 currentYt = 0; // YT_KHYPE not available on testnet

        console.log("   Escrow kHYPE: ", currentKhype);
        console.log("   Escrow PT-kHYPE:", currentPt);
        console.log("   Escrow YT-kHYPE:", currentYt);

        if (currentPt > 0) {
            console.log("\n5. PROJECTED RETURNS:");
            uint256 maturityValue = currentPt;
            uint256 profit = maturityValue > ALLOCATION_AMOUNT ? maturityValue - ALLOCATION_AMOUNT : 0;
            uint256 apy = profit * 100 * 365 / ALLOCATION_AMOUNT / 30; // Rough APY for 30 days

            console.log("   Value at maturity:", maturityValue);
            console.log("   Expected profit:  ", profit);
            console.log("   Estimated APY:    ", apy, "%");
        }
    }

    function printSummary() internal view {
        console.log("\n=================================================");
        console.log("    TEST SUMMARY");
        console.log("=================================================");

        console.log("\nDEPOSIT RESULTS:");
        console.log("  * Deposited:    ", DEPOSIT_AMOUNT);
        console.log("  * Shares:       ", vaultShares);
        console.log("  * Share price:  ", vaultShares > 0 ? DEPOSIT_AMOUNT * 1e18 / vaultShares : 0);

        console.log("\nALLOCATION RESULTS:");
        console.log("  * Allocated:    ", ALLOCATION_AMOUNT);
        console.log("  * Escrow received:", escrowBalance);
        console.log("  * Efficiency:   ", escrowBalance * 100 / ALLOCATION_AMOUNT, "%");

        console.log("\nPT-kHYPE POSITION:");
        console.log("  * PT balance:   ", ptBalance);
        if (ptBalance > 0 && escrowBalance > 0) {
            console.log("  * Exchange rate:", ptBalance * 1e18 / escrowBalance);
            console.log("  * Premium:     ", (ptBalance - escrowBalance) * 100 / escrowBalance, "%");
        }

        console.log("\nSTRATEGY STATUS:");
        console.log("  * Vault configured:  ", vault.isAllocator(vm.addr(vm.envUint("PRIVATE_KEY"))));
        console.log("  * Adapter linked:    ", escrow.adapter() == address(adapter));
        console.log("  * Pendle approved:   ", KHYPE.allowance(address(escrow), address(PENDLE_ROUTER)) > 0);
        console.log("  * Loop ready:        ", ptBalance > 0 || escrowBalance > 0);

        console.log("\n=================================================");
        console.log("    PT-kHYPE LOOP STRATEGY TEST COMPLETE!");
        console.log("=================================================");
    }
}