pragma solidity 0.8.28;

import {IERC20} from "../interfaces/IERC20.sol";

/// @title AaveV3Valuer
/// @notice Example valuer for Aave V3 lending strategy
/// @dev Demonstrates how to add a new strategy to Universal Adapter
contract AaveV3Valuer {
    /* CONSTANTS */

    uint256 private constant PRECISION = 1e18;

    /* IMMUTABLES */

    address public immutable aavePool;
    address public immutable aaveOracle;
    address public immutable baseAsset; // e.g., USDC

    /* CONSTRUCTOR */

    constructor(
        address _aavePool,
        address _aaveOracle,
        address _baseAsset
    ) {
        aavePool = _aavePool;
        aaveOracle = _aaveOracle;
        baseAsset = _baseAsset;
    }

    /* EXTERNAL FUNCTIONS */

    /// @notice Get total value of Aave V3 position
    /// @param escrow The escrow holding the position
    /// @return Total position value in base asset
    function getValue(
        address escrow,
        bytes32 /* strategyId */
    ) external view returns (uint256) {
        // Get account data from Aave
        (
            uint256 totalCollateralBase,
            uint256 totalDebtBase,
            uint256 availableBorrowsBase,
            uint256 currentLiquidationThreshold,
            uint256 ltv,
            uint256 healthFactor
        ) = IAavePool(aavePool).getUserAccountData(escrow);

        // Simple NPV: collateral - debt
        if (totalCollateralBase > totalDebtBase) {
            return totalCollateralBase - totalDebtBase;
        }

        return 0; // Underwater position
    }

    /// @notice Get health factor of Aave position
    /// @param escrow The escrow address
    /// @return Health factor (1e18 = 1.0)
    function getHealthFactor(address escrow) external view returns (uint256) {
        (, , , , , uint256 healthFactor) = IAavePool(aavePool).getUserAccountData(escrow);
        return healthFactor;
    }

    /// @notice Get breakdown of Aave position
    /// @param escrow The escrow address
    /// @return collateral Total collateral value
    /// @return debt Total debt value
    /// @return apr Current borrow APR
    function getPositionDetails(address escrow)
        external
        view
        returns (
            uint256 collateral,
            uint256 debt,
            uint256 apr
        )
    {
        (collateral, debt, , , , ) = IAavePool(aavePool).getUserAccountData(escrow);

        // Get current borrow rate
        DataTypes.ReserveData memory reserveData = IAavePool(aavePool).getReserveData(
            baseAsset
        );
        apr = reserveData.currentVariableBorrowRate;
    }
}

/* INTERFACES */

interface IAavePool {
    function getUserAccountData(address user)
        external
        view
        returns (
            uint256 totalCollateralBase,
            uint256 totalDebtBase,
            uint256 availableBorrowsBase,
            uint256 currentLiquidationThreshold,
            uint256 ltv,
            uint256 healthFactor
        );

    function supply(
        address asset,
        uint256 amount,
        address onBehalfOf,
        uint16 referralCode
    ) external;

    function borrow(
        address asset,
        uint256 amount,
        uint256 interestRateMode,
        uint16 referralCode,
        address onBehalfOf
    ) external;

    function repay(
        address asset,
        uint256 amount,
        uint256 rateMode,
        address onBehalfOf
    ) external returns (uint256);

    function withdraw(
        address asset,
        uint256 amount,
        address to
    ) external returns (uint256);

    function getReserveData(address asset)
        external
        view
        returns (DataTypes.ReserveData memory);
}

library DataTypes {
    struct ReserveData {
        uint128 liquidityIndex;
        uint128 currentLiquidityRate;
        uint128 variableBorrowIndex;
        uint128 currentVariableBorrowRate;
        uint128 currentStableBorrowRate;
        uint40 lastUpdateTimestamp;
        uint16 id;
        address aTokenAddress;
        address stableDebtTokenAddress;
        address variableDebtTokenAddress;
        address interestRateStrategyAddress;
        uint128 accruedToTreasury;
        uint128 unbacked;
        uint128 isolationModeTotalDebt;
    }
}