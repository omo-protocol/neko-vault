pragma solidity 0.8.28;

import {IERC20} from "../interfaces/IERC20.sol";
import {IPTLoopValuer} from "./interfaces/IPTLoopValuer.sol";

/// @title PTLoopValuer
/// @notice Valuer for PT-kHYPE leveraged loop strategy using Pendle and Felix
/// @dev Calculates NPV of PT loop positions including leverage
contract PTLoopValuer is IPTLoopValuer {
    /* CONSTANTS */

    uint256 private constant PRECISION = 1e18;

    /* IMMUTABLES */

    address public immutable kHYPE;
    address public immutable PT_KHYPE;
    address public immutable PENDLE_MARKET;
    address public immutable PENDLE_ROUTER_STATIC;
    address public immutable FELIX;
    bytes32 public immutable FELIX_MARKET_ID;

    /* CONSTRUCTOR */

    constructor(
        address _khype,
        address _ptKhype,
        address _pendleMarket,
        address _pendleRouterStatic,
        address _felix,
        bytes32 _felixMarketId
    ) {
        kHYPE = _khype;
        PT_KHYPE = _ptKhype;
        PENDLE_MARKET = _pendleMarket;
        PENDLE_ROUTER_STATIC = _pendleRouterStatic;
        FELIX = _felix;
        FELIX_MARKET_ID = _felixMarketId;
    }

    /* EXTERNAL FUNCTIONS */

    /// @inheritdoc IPTLoopValuer
    function getPTLoopValue(address escrow) external view override returns (uint256) {
        // Get free PT balance (not used as collateral)
        uint256 freePT = IERC20(PT_KHYPE).balanceOf(escrow);

        // Get Felix position
        (uint256 collateralPT, uint256 borrowedKhype) = _getFelixPosition(escrow);

        // Get PT to kHYPE exchange rate from Pendle
        uint256 ptRate = _getPTToAssetRate();

        // Calculate values in kHYPE
        uint256 freePTValue = (freePT * ptRate) / PRECISION;
        uint256 collateralValue = (collateralPT * ptRate) / PRECISION;

        // Get free kHYPE balance
        uint256 freeKhype = IERC20(kHYPE).balanceOf(escrow);

        // Calculate NPV
        uint256 totalAssets = freePTValue + collateralValue + freeKhype;
        uint256 totalDebt = borrowedKhype;

        if (totalAssets > totalDebt) {
            return totalAssets - totalDebt;
        }

        return 0; // Underwater position
    }

    /// @inheritdoc IPTLoopValuer
    function getHealthFactor(address escrow) external view override returns (uint256) {
        (uint256 collateralPT, uint256 borrowedKhype) = _getFelixPosition(escrow);

        if (borrowedKhype == 0) return type(uint256).max; // No debt

        // Get PT rate and LTV
        uint256 ptRate = _getPTToAssetRate();
        uint256 ltv = _getFelixLTV();

        // Calculate collateral value in kHYPE
        uint256 collateralValue = (collateralPT * ptRate) / PRECISION;

        // Calculate max borrowable
        uint256 maxBorrowable = (collateralValue * ltv) / PRECISION;

        // Health factor = maxBorrowable / borrowed
        return (maxBorrowable * PRECISION) / borrowedKhype;
    }

    /// @inheritdoc IPTLoopValuer
    function getLeverageRatio(address escrow) external view override returns (uint256) {
        uint256 netValue = this.getPTLoopValue(escrow);
        if (netValue == 0) return 0;

        (uint256 collateralPT, ) = _getFelixPosition(escrow);
        uint256 freePT = IERC20(PT_KHYPE).balanceOf(escrow);
        uint256 totalPT = collateralPT + freePT;

        uint256 ptRate = _getPTToAssetRate();
        uint256 totalPTValue = (totalPT * ptRate) / PRECISION;

        // Leverage = totalPosition / netValue
        return (totalPTValue * PRECISION) / netValue;
    }

    /// @inheritdoc IPTLoopValuer
    function getComponentValues(
        address escrow
    )
        external
        view
        override
        returns (uint256 freePT, uint256 collateralPT, uint256 debt, uint256 freeUnderlying)
    {
        freePT = IERC20(PT_KHYPE).balanceOf(escrow);
        (collateralPT, debt) = _getFelixPosition(escrow);
        freeUnderlying = IERC20(kHYPE).balanceOf(escrow);
    }

    /* INTERNAL FUNCTIONS */

    /// @dev Get Felix lending position
    function _getFelixPosition(
        address escrow
    ) internal view returns (uint256 collateral, uint256 borrowed) {
        IFelix felix = IFelix(FELIX);
        Position memory pos = felix.position(FELIX_MARKET_ID, escrow);

        collateral = pos.collateral;
        borrowed = pos.borrowBalance;
    }

    /// @dev Get PT to underlying asset rate from Pendle
    function _getPTToAssetRate() internal view returns (uint256) {
        // Use Pendle Router Static for accurate PT pricing
        IPendleRouterStatic router = IPendleRouterStatic(PENDLE_ROUTER_STATIC);

        // Get PT to asset rate (protocol-native, no oracle needed)
        uint256 ptRate = router.getPtToAssetRate(PENDLE_MARKET);

        return ptRate;
    }

    /// @dev Get Felix market LTV
    function _getFelixLTV() internal view returns (uint256) {
        IFelix felix = IFelix(FELIX);
        MarketParams memory params = felix.marketParams(FELIX_MARKET_ID);

        return params.ltv;
    }
}

/* INTERFACE DEFINITIONS */

struct Position {
    uint256 collateral;
    uint256 borrowBalance;
}

struct MarketParams {
    uint256 ltv;
    uint256 liquidationThreshold;
    uint256 liquidationPenalty;
}

interface IFelix {
    function position(
        bytes32 marketId,
        address user
    ) external view returns (Position memory);

    function marketParams(bytes32 marketId) external view returns (MarketParams memory);
}

interface IPendleRouterStatic {
    function getPtToAssetRate(address market) external view returns (uint256);
}