pragma solidity 0.8.28;

import {IERC20} from "../interfaces/IERC20.sol";
import {IVNekoValuer} from "./interfaces/IVNekoValuer.sol";
import {IStrategyEscrow} from "../adapters/interfaces/IStrategyEscrow.sol";

/// @title VNekoComplexValuer
/// @notice Valuer for vNeko complex strategies including VF, lending, MM, and arbitrage
/// @dev Handles valuation for all vNeko strategy components
contract VNekoComplexValuer is IVNekoValuer {
    /* CONSTANTS */

    uint256 private constant PRECISION = 1e18;
    uint256 private constant SAFETY_BUFFER_BPS = 150; // 1.5% safety buffer

    /* IMMUTABLES */

    address public immutable NEKO;
    address public immutable HYPE;
    address public immutable vNEKO;
    address public immutable VNEKO_HYPE_LP;
    address public immutable MORPHO;
    address public immutable MORPHO_ORACLE;
    bytes32 public immutable VNEKO_MARKET_ID;

    /* CONSTRUCTOR */

    constructor(
        address _neko,
        address _hype,
        address _vneko,
        address _vnekoHypeLp,
        address _morpho,
        address _morphoOracle,
        bytes32 _vnekoMarketId
    ) {
        NEKO = _neko;
        HYPE = _hype;
        vNEKO = _vneko;
        VNEKO_HYPE_LP = _vnekoHypeLp;
        MORPHO = _morpho;
        MORPHO_ORACLE = _morphoOracle;
        VNEKO_MARKET_ID = _vnekoMarketId;
    }

    /* EXTERNAL FUNCTIONS */

    /// @inheritdoc IVNekoValuer
    function getTotalValue(address escrow) external view override returns (uint256) {
        uint256 totalValue;

        // S0: Buffer value (idle NEKO and HYPE)
        totalValue += _getBufferValue(escrow);

        // S1: RubFi Market Making value
        totalValue += this.getMarketMakingValue(escrow);

        // S2: Volatility Farming value
        totalValue += this.getVolatilityFarmingValue(escrow);

        // S3: vNEKO collateral lending value
        totalValue += this.getLendingPositionValue(escrow);

        // S4: Parity arbitrage value
        totalValue += this.getArbPositionValue(escrow);

        return totalValue;
    }

    /// @inheritdoc IVNekoValuer
    function getVolatilityFarmingValue(address escrow) external view override returns (uint256) {
        // Get LP token balance
        uint256 lpBalance = IERC20(VNEKO_HYPE_LP).balanceOf(escrow);
        if (lpBalance == 0) return 0;

        // Get LP reserves and total supply
        (uint256 vNekoReserve, uint256 hypeReserve) = _getLPReserves();
        uint256 totalSupply = IERC20(VNEKO_HYPE_LP).totalSupply();

        // Calculate escrow's share of reserves
        uint256 vNekoShare = (vNekoReserve * lpBalance) / totalSupply;
        uint256 hypeShare = (hypeReserve * lpBalance) / totalSupply;

        // Convert to NEKO value
        uint256 vNekoInNeko = _convertVNekoToNeko(vNekoShare);
        uint256 hypeInNeko = _convertHypeToNeko(hypeShare);

        return vNekoInNeko + hypeInNeko;
    }

    /// @inheritdoc IVNekoValuer
    function getLendingPositionValue(address escrow) external view override returns (uint256) {
        // Get Morpho position
        (uint256 collateral, uint256 borrowed) = _getMorphoPosition(escrow);

        if (collateral == 0 && borrowed == 0) return 0;

        // Convert collateral (vNEKO) to NEKO
        uint256 collateralInNeko = _convertVNekoToNeko(collateral);

        // Convert borrowed (HYPE) to NEKO
        uint256 borrowedInNeko = _convertHypeToNeko(borrowed);

        // Apply safety buffer to borrowed amount
        uint256 buffer = (borrowedInNeko * SAFETY_BUFFER_BPS) / 10000;

        // NPV calculation
        if (collateralInNeko > borrowedInNeko + buffer) {
            return collateralInNeko - borrowedInNeko - buffer;
        }

        return 0; // Underwater position
    }

    /// @inheritdoc IVNekoValuer
    function getMarketMakingValue(address escrow) external view override returns (uint256) {
        // This would integrate with RubFi bridge adapter to get cross-chain MM positions
        // For now, return tracked allocation

        // Get MM position from escrow's strategy data
        bytes memory positionData = IStrategyEscrow(escrow).getStrategyPosition(
            keccak256("VNEKO_MM")
        );

        if (positionData.length == 0) return 0;

        // Decode position value (simplified)
        (uint256 mmValue, ) = abi.decode(positionData, (uint256, uint256));

        return mmValue;
    }

    /// @inheritdoc IVNekoValuer
    function getArbPositionValue(address escrow) external view override returns (uint256) {
        // Get arbitrage position data
        bytes memory positionData = IStrategyEscrow(escrow).getStrategyPosition(
            keccak256("VNEKO_ARB")
        );

        if (positionData.length == 0) return 0;

        // Decode position value
        (uint256 arbValue, ) = abi.decode(positionData, (uint256, uint256));

        return arbValue;
    }

    /* INTERNAL FUNCTIONS */

    /// @dev Get buffer value (idle NEKO and HYPE in escrow)
    function _getBufferValue(address escrow) internal view returns (uint256) {
        uint256 nekoBalance = IERC20(NEKO).balanceOf(escrow);
        uint256 hypeBalance = IERC20(HYPE).balanceOf(escrow);

        // NEKO is already in base currency
        uint256 hypeInNeko = _convertHypeToNeko(hypeBalance);

        return nekoBalance + hypeInNeko;
    }

    /// @dev Get LP pool reserves
    function _getLPReserves() internal view returns (uint256 vNekoReserve, uint256 hypeReserve) {
        // Call LP pool to get reserves
        // This would interface with the actual AMM pool contract
        // Simplified for now
        (uint112 reserve0, uint112 reserve1, ) = IUniswapV2Pair(VNEKO_HYPE_LP).getReserves();
        vNekoReserve = uint256(reserve0);
        hypeReserve = uint256(reserve1);
    }

    /// @dev Get Morpho position for escrow
    function _getMorphoPosition(
        address escrow
    ) internal view returns (uint256 collateral, uint256 borrowed) {
        // Interface with Morpho to get position
        IMorphoV2 morpho = IMorphoV2(MORPHO);

        collateral = morpho.collateral(VNEKO_MARKET_ID, escrow);
        borrowed = morpho.borrowBalance(VNEKO_MARKET_ID, escrow);
    }

    /// @dev Convert vNEKO amount to NEKO value
    function _convertVNekoToNeko(uint256 vNekoAmount) internal view returns (uint256) {
        if (vNekoAmount == 0) return 0;

        // Get vNEKO price per share
        uint256 pricePerShare = IVault(vNEKO).pricePerShare();

        return (vNekoAmount * pricePerShare) / PRECISION;
    }

    /// @dev Convert HYPE amount to NEKO value
    function _convertHypeToNeko(uint256 hypeAmount) internal view returns (uint256) {
        if (hypeAmount == 0) return 0;

        // Get HYPE/NEKO price from oracle or TWAP
        uint256 hypePerNeko = _getHypeToNekoPrice();

        return (hypeAmount * PRECISION) / hypePerNeko;
    }

    /// @dev Get HYPE to NEKO price
    function _getHypeToNekoPrice() internal view returns (uint256) {
        // This would interface with oracle aggregator
        // For now, return a placeholder
        return 2 * PRECISION; // 1 HYPE = 2 NEKO
    }
}

/* INTERFACE DEFINITIONS */

// IStrategyEscrow is imported from ../adapters/interfaces/IStrategyEscrow.sol

interface IUniswapV2Pair {
    function getReserves() external view returns (uint112 reserve0, uint112 reserve1, uint32);
}

interface IMorphoV2 {
    function collateral(bytes32 id, address user) external view returns (uint256);
    function borrowBalance(bytes32 id, address user) external view returns (uint256);
}

interface IVault {
    function pricePerShare() external view returns (uint256);
}