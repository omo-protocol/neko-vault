pragma solidity 0.8.28;

import {MorphoPTLoopAdapter} from "./MorphoPTLoopAdapter.sol";
import {MarketParams} from "../../lib/morpho-blue/src/interfaces/IMorpho.sol";

/// @title MorphoPTLoopAdapterFactory
/// @notice Factory for creating MorphoPTLoopAdapter instances
interface IMorphoPTLoopAdapterFactory {
    
    /* EVENTS */
    
    event CreateMorphoPTLoopAdapter(
        address indexed parentVault,
        address indexed morpho,
        address indexed pendleRouter,
        address ptToken,
        bytes32 marketId,
        address adapter
    );
    
    /* VIEW FUNCTIONS */
    
    /// @notice Get adapter address for given parameters
    function morphoPTLoopAdapter(
        address parentVault,
        address morpho,
        address pendleRouter,
        address ptToken,
        bytes32 marketId
    ) external view returns (address);
    
    /// @notice Check if address is a PT loop adapter created by this factory
    function isMorphoPTLoopAdapter(address adapter) external view returns (bool);
    
    /* FUNCTIONS */
    
    /// @notice Create a new MorphoPTLoopAdapter
    function createMorphoPTLoopAdapter(
        address parentVault,
        address morpho,
        address pendleRouter,
        address ptToken,
        MarketParams calldata loopMarketParams
    ) external returns (address);
}

contract MorphoPTLoopAdapterFactory is IMorphoPTLoopAdapterFactory {
    
    /* STORAGE */
    
    /// @notice Mapping from parameters to adapter address
    mapping(bytes32 => address) public adapterByParamsHash;
    
    /// @notice Mapping to check if address is a PT loop adapter
    mapping(address => bool) public isMorphoPTLoopAdapter;
    
    /// @notice Get adapter address for given parameters
    function morphoPTLoopAdapter(
        address parentVault,
        address morpho,
        address pendleRouter,
        address ptToken,
        bytes32 marketId
    ) external view returns (address) {
        bytes32 paramsHash = keccak256(abi.encode(parentVault, morpho, pendleRouter, ptToken, marketId));
        return adapterByParamsHash[paramsHash];
    }
    
    /* FUNCTIONS */
    
    /// @notice Create a new MorphoPTLoopAdapter instance
    /// @param parentVault The vault that will use this adapter
    /// @param morpho The Morpho protocol contract (Felix vanilla)
    /// @param pendleRouter The Pendle router for PT conversions
    /// @param ptToken The PT token address (kHYPE-PT)
    /// @param loopMarketParams The Morpho market parameters for the loop strategy
    /// @return adapter The address of the created adapter
    function createMorphoPTLoopAdapter(
        address parentVault,
        address morpho,
        address pendleRouter,
        address ptToken,
        MarketParams calldata loopMarketParams
    ) external returns (address adapter) {
        
        bytes32 paramsHash = keccak256(abi.encode(
            parentVault,
            morpho, 
            pendleRouter,
            ptToken,
            loopMarketParams.id()
        ));
        
        // Check if adapter already exists
        require(adapterByParamsHash[paramsHash] == address(0), "Adapter already exists");
        
        // Create adapter with deterministic salt for predictable addresses
        adapter = address(new MorphoPTLoopAdapter{salt: paramsHash}(
            parentVault,
            morpho,
            pendleRouter, 
            ptToken,
            loopMarketParams
        ));
        
        // Store adapter reference
        adapterByParamsHash[paramsHash] = adapter;
        isMorphoPTLoopAdapter[adapter] = true;
        
        emit CreateMorphoPTLoopAdapter(
            parentVault,
            morpho,
            pendleRouter,
            ptToken,
            loopMarketParams.id(),
            adapter
        );
        
        return adapter;
    }
    
    /// @notice Predict the address of a MorphoPTLoopAdapter before creation
    /// @param parentVault The vault that will use this adapter
    /// @param morpho The Morpho protocol contract
    /// @param pendleRouter The Pendle router address
    /// @param ptToken The PT token address
    /// @param loopMarketParams The market parameters
    /// @return adapter The predicted adapter address
    function predictAdapterAddress(
        address parentVault,
        address morpho,
        address pendleRouter,
        address ptToken,
        MarketParams calldata loopMarketParams
    ) external view returns (address adapter) {
        
        bytes32 paramsHash = keccak256(abi.encode(
            parentVault,
            morpho,
            pendleRouter,
            ptToken,
            loopMarketParams.id()
        ));
        
        // Calculate CREATE2 address
        bytes32 bytecodeHash = keccak256(abi.encodePacked(
            type(MorphoPTLoopAdapter).creationCode,
            abi.encode(parentVault, morpho, pendleRouter, ptToken, loopMarketParams)
        ));
        
        adapter = address(uint160(uint256(keccak256(abi.encodePacked(
            bytes1(0xff),
            address(this),
            paramsHash,
            bytecodeHash
        )))));
        
        return adapter;
    }
    
    /// @notice Get creation parameters for an existing adapter
    /// @param adapter The adapter address
    /// @return parentVault The parent vault address
    /// @return morpho The Morpho contract address
    /// @return pendleRouter The Pendle router address
    /// @return ptToken The PT token address
    function getAdapterParams(address adapter) external view returns (
        address parentVault,
        address morpho,
        address pendleRouter,
        address ptToken
    ) {
        require(isMorphoPTLoopAdapter[adapter], "Not a PT loop adapter");
        
        MorphoPTLoopAdapter ptAdapter = MorphoPTLoopAdapter(adapter);
        
        return (
            ptAdapter.parentVault(),
            ptAdapter.morpho(),
            ptAdapter.pendleRouter(),
            ptAdapter.ptToken()
        );
    }
}