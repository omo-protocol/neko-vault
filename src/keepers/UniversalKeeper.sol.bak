pragma solidity 0.8.28;

/// @title UniversalKeeper
/// @notice Universal keeper framework for automated strategy maintenance
/// @dev Manages scheduled tasks and keeper coordination
contract UniversalKeeper {
    /* STRUCTS */

    struct KeeperTask {
        bytes32 taskId;
        bytes32 strategyId;
        uint256 interval;
        uint256 lastRun;
        address target;
        bytes callData;
        bool active;
    }

    /* EVENTS */

    event TaskRegistered(
        bytes32 indexed taskId,
        bytes32 indexed strategyId,
        uint256 interval
    );
    event TaskExecuted(bytes32 indexed taskId, uint256 timestamp);
    event TaskUpdated(bytes32 indexed taskId, bool active);
    event KeeperAuthorized(address indexed keeper, bool authorized);

    /* ERRORS */

    error NotAuthorized();
    error TaskNotReady();
    error TaskFailed(bytes32 taskId);
    error InvalidInterval();

    /* IMMUTABLES */

    address public immutable owner;
    address public immutable escrow;

    /* STORAGE */

    mapping(bytes32 => KeeperTask) public tasks;
    mapping(address => bool) public authorizedKeepers;
    bytes32[] public taskIds;

    /* MODIFIERS */

    modifier onlyOwner() {
        if (msg.sender != owner) revert NotAuthorized();
        _;
    }

    modifier onlyKeeper() {
        if (!authorizedKeepers[msg.sender] && msg.sender != owner) {
            revert NotAuthorized();
        }
        _;
    }

    /* CONSTRUCTOR */

    constructor(address _owner, address _escrow) {
        owner = _owner;
        escrow = _escrow;
    }

    /* EXTERNAL FUNCTIONS */

    /// @notice Register a new keeper task
    /// @param strategyId Strategy this task belongs to
    /// @param taskId Unique task identifier
    /// @param interval Minimum time between executions
    /// @param target Contract to call
    /// @param callData Function call data
    function registerTask(
        bytes32 strategyId,
        bytes32 taskId,
        uint256 interval,
        address target,
        bytes calldata callData
    ) external onlyOwner {
        if (interval == 0) revert InvalidInterval();

        tasks[taskId] = KeeperTask({
            taskId: taskId,
            strategyId: strategyId,
            interval: interval,
            lastRun: block.timestamp,
            target: target,
            callData: callData,
            active: true
        });

        taskIds.push(taskId);

        emit TaskRegistered(taskId, strategyId, interval);
    }

    /// @notice Execute a keeper task
    /// @param taskId Task to execute
    function executeTask(bytes32 taskId) external onlyKeeper {
        KeeperTask storage task = tasks[taskId];

        if (!task.active) revert TaskNotReady();
        if (block.timestamp < task.lastRun + task.interval) {
            revert TaskNotReady();
        }

        task.lastRun = block.timestamp;

        (bool success, ) = task.target.call(task.callData);
        if (!success) revert TaskFailed(taskId);

        emit TaskExecuted(taskId, block.timestamp);
    }

    /// @notice Check if task is ready for execution
    /// @param taskId Task to check
    /// @return ready Whether task can be executed
    /// @return data Call data if ready
    function checkTask(bytes32 taskId) external view returns (bool ready, bytes memory data) {
        KeeperTask memory task = tasks[taskId];

        if (!task.active) return (false, "");
        if (block.timestamp < task.lastRun + task.interval) return (false, "");

        return (true, task.callData);
    }

    /// @notice Get all tasks ready for execution
    /// @return readyTasks Array of task IDs ready to execute
    function getReadyTasks() external view returns (bytes32[] memory readyTasks) {
        uint256 count = 0;
        bytes32[] memory temp = new bytes32[](taskIds.length);

        for (uint256 i = 0; i < taskIds.length; i++) {
            KeeperTask memory task = tasks[taskIds[i]];
            if (task.active && block.timestamp >= task.lastRun + task.interval) {
                temp[count] = taskIds[i];
                count++;
            }
        }

        readyTasks = new bytes32[](count);
        for (uint256 i = 0; i < count; i++) {
            readyTasks[i] = temp[i];
        }
    }

    /* ADMIN FUNCTIONS */

    /// @notice Update task active status
    function updateTaskStatus(bytes32 taskId, bool active) external onlyOwner {
        tasks[taskId].active = active;
        emit TaskUpdated(taskId, active);
    }

    /// @notice Authorize or revoke keeper
    function setKeeperAuthorization(address keeper, bool authorized) external onlyOwner {
        authorizedKeepers[keeper] = authorized;
        emit KeeperAuthorized(keeper, authorized);
    }

    /// @notice Update task interval
    function updateTaskInterval(bytes32 taskId, uint256 newInterval) external onlyOwner {
        if (newInterval == 0) revert InvalidInterval();
        tasks[taskId].interval = newInterval;
    }
}