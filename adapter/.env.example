# Neko adapter env template — copy to `.env` and populate.

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000

# ─── Base chain ──────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453

# Fallback Base signer key. Production should rely on the `x-base-signer-key` header
# that the TEE injects per request (sourced from ECIES-encrypted secrets or dKMS). This env var is a dev/local fallback.
BASE_SIGNER_KEY=0x...

# Deployed Base contracts (from `BaseCustodyFactory.deploy` output).
GATEWAY=0x...
GATEWAY_NAME=NekoBaseGateway
GATEWAY_VERSION=1
VALUER=0x...
BASE_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VAULT=0x...

# ─── Venue SDK endpoints (defaults target mainnet) ────────────────────────
HL_API_URL=https://api.hyperliquid.xyz
PM_API_URL=https://clob.polymarket.com

# ─── Market registries ───────────────────────────────────────────────────
# Point these at JSON files mapping marketRef bytes32 → venue-specific asset metadata.
# See adapter/markets/hl-markets.example.json and pm-markets.example.json.
# Omit to fall back to mock adapters.
HL_MARKETS_PATH=./markets/hl-markets.json
PM_MARKETS_PATH=./markets/pm-markets.json
